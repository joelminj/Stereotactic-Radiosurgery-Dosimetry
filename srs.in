# >>>> SIMULATION CONFIG FILE FOR penEasy >>>>>>>>>
#
# Case description:
#   SRS cone simulation with 10mm aperture. 6 MeV photon beam in -Z.
#
# Last update:
#   2025-05-30 by Joel Minj
#

# >>>> GENERAL >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

[SECTION CONFIG v.2013-03-18]
  1.0e7                NUMBER OF HISTORIES
  3600.0               ALLOTTED TIME (s) (+ FOR REAL TIME)
  600.0                UPDATE INTERVAL (s)
  1 1                  INITIAL RANDOM SEEDS
  -                    SEEDS FILE; MUST ENTER SEEDS=0,0 TO APPLY
  -                    RESTART FILE; MUST ENTER SEEDS=-1,-1 TO APPLY
  srs.dmp         OUTPUT DUMP FILE; ENTER '-' FOR 'NO DUMP'
  600.0                INTERVAL BETWEEN DUMPS (s)
[END OF CONFIG SECTION]


# >>>> SOURCES >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

[SECTION SOURCE BOX ISOTROPIC GAUSS SPECTRUM v.2014-12-21]
  ON                   STATUS (ON or OFF)
  2                    PARTICLE TYPE (2=PHOTON)
  SUBSECTION FOR PHOTON POLARIZATION:
  0                    ACTIVATE PHOTON POLARIZATION PHYSICS (0=NO)
  0.0 0.0 0.0          STOKES PARAMETERS
  SUBSECTION FOR PARTICLE POSITION:
  0.0  0.0  74.0       COORDINATES (cm) OF BOX CENTER (point source)
  0.89  0.89  0.0      BOX SIDES (cm) (point source)
  0.0  0.0             FWHMs (cm) OF GAUSSIAN X,Y DISTRIBUTIONS
  0.0  0.0  0.0        EULER ANGLES [OMEGA,THETA,PHI](deg) FOR BOX ROTATION
  0.0  0.0  0.0        TRANSLATION [DX,DY,DZ](cm) OF BOX CENTER POSITION
  0                    SOURCE MATERIAL (0=DON'T CARE)
  SUBSECTION FOR PARTICLE DIRECTION:
  0.0  0.0  -1.0       DIRECTION VECTOR (-Z direction)
  0.0  0.0             DIRECTION POLAR ANGLE INTERVAL [THETA0,THETA1] (deg) (Parallel)
  0.0 360.0            DIRECTION AZIMUTHAL ANGLE INTERVAL PHI0 AND DeltaPHI (deg)
  0                    APPLY ALSO TO DIRECTION THE ROTATION USED FOR BOX POSITION (0=NO)
  SUBSECTION FOR PARTICLE ENERGY:
  -                    ENERGY SPECTRUM FILE NAME
  Energy(eV)  Probability  DUMMY HEADER LINE
  6.0e6       1.0        6 MeV photons
  6.0e6      -1.0        End of spectrum table
  0.0                  FWHM(eV) OF GAUSSIAN ENERGY DISTRIB.
[END OF BIGS SECTION]

[SECTION SOURCE PHASE SPACE FILE v.2009-06-15]
  OFF                   STATUS (ON or OFF)
  0                    PSF FORMAT (0=STANDARD penEasy ASCII)
  output.psf           PSF FILENAME (from Step 1)
  20                   SPLITTING FACTOR (Increase for more stats if PSF is limited, e.g., 10, 20, 50)
  0.0 0.0 0.0          EULER ANGLES [Rz,Ry,Rz](deg) TO ROTATE (No rotation)
  0.0 0.0 0.0          CARTESIAN COMPONENTS [DX,DY,DZ](cm) OF POSITION SHIFT (PSF origin at 0,0,0)
  0                    VALIDATE BEFORE SIMULATION (0=NO for faster start with trusted PSF)
  7.0e6                MAX PSF ENERGY (eV) (Set slightly above your max source energy, e.g. 6MeV source -> 7MeV)
[END OF SPSF SECTION]


# >>>> EM fields >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
[SECTION EMF v.2024-02-04]
  0.0 0.0 0.0          ELECTRIC FIELD (volt/cm)
  0.0 0.0 0.0          MAGNETIC FIELD (gauss)
  0.01                 ULDV PARAMETER
  0.01                 ULDE PARAMETER
  0.01                 ULEM PARAMETER
[END OF EMF SECTION]


# >>>> PENGEOM+PENVOX >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
[SECTION PENGEOM+PENVOX v.2009-06-15]
  srs.geo              QUADRICS FILE NAME (Your working .geo file)
  -                    VOXELS FILE NAME, USE '-' IF NONE
  1                    TRANSPARENT QUADRIC MAT
  10                   GRANULARITY TO SCAN VOXELS
[END OF GEO SECTION]


# >>>> TRANSPORT PARAMETERS >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
[SECTION PENELOPE v.2019-08-06]
  MAT# FILE___(max 20 char) EABS(e-)  EABS(ph)  EABS(e+)  C1    C2    WCC      WCR      DSMAX   COMMENTS
   1   W_alloy95NiFe.mat    5.0e5     1.0e5     5.0e5     0.10  0.10  5.0e5    5.0e5    1.0e30  ! Tungsten Alloy
   2   water.mat            6.0e4     6.0e3     1.0e4     0.1   0.1   6.0e4    6.0e3    1.0e30  ! Water
   3   air.mat              1.0e5     1.0e4     1.0e5     0.10  0.10  1.0e5    1.0e5    1.0e30  ! Air
   4   W.mat                100.0e3   100.0e3   100.0e3   0.1   0.1   100.0e3  100.0e3  0.04    ! W target
  -1 (SET MAT=-1 TO END THE LIST)
[END OF PEN SECTION]


# >>>> TALLIES >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# Phantom is at Z = -90cm to -130cm.
# Depth-dose: z in [0,7] cm implies global Z in [-90, -97] cm.
# Cylindrical dose: z in [0,7] cm implies global Z in [-90, -97] cm.

[SECTION TALLY VOXEL DOSE v.2014-12-27]
 OFF                             STATUS (ON or OFF)
 0  0                            ROI X-INDEX MIN,MAX (0 0 FOR ALL VOXELS)
 0  0                            ROI Y-INDEX MIN,MAX (0 0 FOR ALL VOXELS)
 0  0                            ROI Z-INDEX MIN,MAX (0 0 FOR ALL VOXELS)
 0                               PRINT VOXELS MASS IN REPORT (1=YES,0=NO)
 1                               PRINT COORDINATES IN REPORT (1=YES,0=NO,-1=NO&BINARYFORMAT)
 0.0                             RELATIVE UNCERTAINTY (%) REQUESTED
[END OF VDD SECTION]

[SECTION TALLY SPATIAL DOSE DISTRIB v.2009-06-15]
  ON                   STATUS (ON or OFF)
  -5.0  5.0  0.0       XMIN,XMAX(cm),NXBIN (0 FOR DX=infty)
  -5.0  5.0  0.0       YMIN,YMAX(cm),NYBIN (0 FOR DY=infty)
  -130.0 -90.0 300     ZMIN,ZMAX(cm),NZBIN (e.g., 2mm Z-voxels for 60cm depth)
  1                    PRINT COORDINATES IN REPORT (1=YES)
  1.0                  RELATIVE UNCERTAINTY (%) REQUESTED
[END OF SDD SECTION]

[SECTION TALLY CYLINDRICAL DOSE DISTRIB v.2009-06-15]
  ON                   STATUS (ON or OFF)
  0.0  10.0  50        RMIN,RMAX(cm),NRBIN (e.g., 1mm radial bins for R=20cm)
  -100.0 -90.0 50      ZMIN,ZMAX(cm),NZBIN (e.g., 1cm Z-bins for 60cm depth)
  1                    PRINT COORDINATES IN REPORT (1=YES)
  0.0                  RELATIVE UNCERTAINTY (%) REQUESTED
[END OF CDD SECTION]

